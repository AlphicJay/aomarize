{
  "name": "aomarize",
  "productName": "Aomarize",
  "version": "1.0.0",
  "description": "A cross-platform Glassmorphism Desktop App for real-time AI news across U.S., UK, Asia, and Africa.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "postinstall": "node node_modules/electron/install.js && (xattr -cr node_modules/electron 2>/dev/null || true) && (codesign --force --deep --sign - node_modules/electron/dist/Electron.app 2>/dev/null || true)",
    "build:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "build:linux": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --x64",
    "build:all": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -mwl --x64",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.aomarize.app",
    "productName": "Aomarize",
    "copyright": "Copyright © 2026 Aomarize Team",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!temp_iconset.iconset/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.news",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Aomarize Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/icons",
      "category": "News",
      "maintainer": "Aomarize Team <team@aomarize.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  },
  "keywords": [
    "ai",
    "news",
    "glassmorphism",
    "desktop-app",
    "electron",
    "us",
    "uk",
    "asia",
    "africa"
  ],
  "author": "Aomarize Team <team@aomarize.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "rss-parser": "^3.13.0"
  }
}
