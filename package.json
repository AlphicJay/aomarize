{
  "name": "aomarize",
  "version": "1.0.0",
  "description": "A cross-platform Glassmorphism Desktop App for real-time AI news across U.S., UK, Asia, and Africa.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "postinstall": "xattr -cr node_modules/electron 2>/dev/null || true",
